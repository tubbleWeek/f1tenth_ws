      <pose>0.125 0 0.155 0 -0 0</pose>
    </frame>
    <frame name='car_1_laser' attached_to='car_1_hokuyo_joint'/>
    <frame name='car_1_left_joint' attached_to='car_1_link'>
      <pose>-2.5 0 1.75 0 0.57 0</pose>
    </frame>
    <frame name='car_1_camera_link' attached_to='car_1_left_joint'/>
    <frame name='car_1_right_joint' attached_to='car_1_link'>
      <pose>0 -0.06 0.025 0 -0 0</pose>
    </frame>
    <frame name='car_1_right_link' attached_to='car_1_right_joint'/>
    <frame name='car_1_joint' attached_to='car_1_chassis'>

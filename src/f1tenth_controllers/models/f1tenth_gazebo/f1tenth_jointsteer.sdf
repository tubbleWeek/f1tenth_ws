    </frame>
    <frame name='car_1_link' attached_to='car_1_joint'/>
    <frame name='car_1_base_link_joint' attached_to='car_1_base_link'>
      <pose>0 0 0.05 0 -0 0</pose>
    </frame>
    <frame name='car_1_chassis' attached_to='car_1_base_link_joint'/>
  </model>
</sdf>

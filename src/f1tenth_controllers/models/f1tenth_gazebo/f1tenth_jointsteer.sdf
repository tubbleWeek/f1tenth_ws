</link>
    <plugin name='gazebo_ros_control' filename='libgazebo_ros_ackermann_drive.so'>
    	<robotNamespace>/car_1</robotNamespace>
  		<robotSimType>gazebo_ros_control/DefaultRobotHWSim</robotSimType>
  		<steering_wheel_joint>car_1_left_steering_hinge_joint</steering_wheel_joint> <!-- Control the left steering hinge -->
  		<front_left_joint>car_1_left_front_wheel_joint</front_left_joint>
  		<front_right_joint>car_1_right_front_wheel_joint</front_right_joint>
  		<rear_right_joint>car_1_right_rear_wheel_joint</rear_right_joint>
  		<rear_left_joint>car_1_left_rear_wheel_joint</rear_left_joint>
    </plugin>
    <plugin name='p3d_base_controller' filename='libgazebo_ros_p3d.so'>
      <alwaysOn>1</alwaysOn>
      <updateRate>50.0</updateRate>
      <body_name>car_1_base_link</body_name>
      <topicName>/car_1/ground_truth</topicName>
      <gaussianNoise>0.01</gaussianNoise>
      <frameName>world</frameName>
      <xyzOffsets>0 0 0</xyzOffsets>
      <rpyOffsets>0 0 0</rpyOffsets>
    </plugin>
    <frame name='car_1_chassis_inertia_joint' attached_to='car_1_chassis'>
      <pose>0 0 0 0 -0 0</pose>
    </frame>

<?xml version="1.0"?>
<!--
  Gazebo ROS ackermann drive plugin demo

  Try sending commands:

    ros2 topic pub /demo/cmd_demo geometry_msgs/msg/Twist '{linear: {x: 1.0}, angular: {z: 0.1}}' -1

  Try listening to odometry:

    ros2 topic echo /demo/odom_demo

  Try listening to odometer reading(linear distance convered):

    ros2 topic echo /demo/distance_demo

  Try listening to TF:

    ros2 run tf2_ros tf2_echo odom_demo chassis

    and other links
-->
<sdf version="1.6">
  <model name="prius_hybrid">
    <!-- Model pose scaled: 0 0 0.03  becomes 0 0 0.00281 -->
    <pose>0 0 0.00281 0 0 0</pose>
    <!-- <link name="base_footprint"/> -->
    <link name="base_link">
      <!-- Chassis link pose remains at the origin -->
      <pose>0 0 0 0 0 1.57</pose>
      <inertial>
        <mass>13.260</mass>
        <!-- Inertial pose: (0, -0.266, 0.48) becomes (0, -0.02493, 0.04502) -->
        <pose>0 -0.02493 0.04502 0 0 0</pose>
        <inertia>
          <ixx>2.58113354740</ixx>
          <ixy>0.0</ixy>
          <iyy>0.59130846112</iyy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
          <izz>2.68195008628</izz>
        </inertia>
      </inertial>

      <!-- Visuals use the mesh scale already set to 0.00099 0.000938 0.000938 -->
      <visual name="chassis_visual">
        <geometry>
          <mesh>
            <uri>model://prius_hybrid/meshes/Hybrid.obj</uri>
            <scale>0.00099 0.000938 0.000938</scale>
            <submesh>
              <name>Hybrid</name>
              <center>false</center>
            </submesh>
          </mesh>
        </geometry>
      </visual>
      

      <visual name="interior_visual">
        <geometry>
          <mesh>
            <uri>model://prius_hybrid/meshes/Hybrid.obj</uri>
            <scale>0.00099 0.000938 0.000938</scale>
            <submesh>
              <name>Hybrid_Interior</name>
              <center>false</center>
            </submesh>
          </mesh>
        </geometry>
      </visual>

      <visual name="windows_visual">
        <geometry>
          <mesh>
            <uri>model://prius_hybrid/meshes/Hybrid.obj</uri>
            <scale>0.00099 0.000938 0.000938</scale>
            <submesh>
              <name>Hybrid_Windows</name>
              <center>false</center>
            </submesh>
          </mesh>
        </geometry>
      </visual>

      <!-- Collisions have both their positions (poses) and sizes scaled -->
      <collision name="base_collision">
        <!-- Original pose (0, 0.05, 0.625) becomes (0, 0.00469, 0.05863) -->
        <pose>0 0.00469 0.05863 0 0 0</pose>
        <geometry>
          <box>
            <!-- Size: 1.7526 2.1 0.95 becomes 0.17351 0.19698 0.08911 -->
            <size>0.17351 0.19698 0.08911</size>
          </box>
        </geometry>
      </collision>

      <collision name="front_bumper">
        <!-- Pose: (0, -2.0, 0.458488) becomes (0, -0.1876, 0.04297) -->
        <pose>0 -0.1876 0.04297 0 0 0</pose>
        <geometry>
          <box>
            <!-- Size: 1.337282 0.48 0.566691 becomes 0.13239 0.04502 0.05312 -->
            <size>0.13239 0.04502 0.05312</size>
          </box>
        </geometry>
      </collision>

      <collision name="hood">
        <!-- Pose: (0, -1.900842, 0.676305) with rotation 0.341247 becomes (0, -0.17818, 0.06344) -->
        <pose>0 -0.17818 0.06344 0.341247 0 0</pose>
        <geometry>
          <box>
            <!-- Size: 1.597968 0.493107 0.265468 becomes 0.15820 0.04624 0.02491 -->
            <size>0.15820 0.04624 0.02491</size>
          </box>
        </geometry>
      </collision>

      <collision name="windshield">
        <!-- Pose: (0, -0.875105, 1.032268) becomes (0, -0.08205, 0.09687) with rotation 0.335476 -->
        <pose>0 -0.08205 0.09687 0.335476 0 0</pose>
        <geometry>
          <box>
            <!-- Size: 1.168381 1.654253 0.272347 becomes 0.11567 0.15524 0.02554 -->
            <size>0.11567 0.15524 0.02554</size>
          </box>
        </geometry>
      </collision>

      <collision name="top_front">
        <!-- Pose: (0, 0.161236, 1.386042) becomes (0, 0.01514, 0.12995) with rotation 0.13503 -->
        <pose>0 0.01514 0.12995 0.13503 0 0</pose>
        <geometry>
          <box>
            <!-- Size: 1.279154 0.625988 0.171868 becomes 0.12664 0.05862 0.01611 -->
            <size>0.12664 0.05862 0.01611</size>
          </box>
        </geometry>
      </collision>

      <collision name="top_rear">
        <!-- Pose: (0, 0.817696, 1.360069) becomes (0, 0.07663, 0.12753) with rotation -0.068997 -->
        <pose>0 0.07663 0.12753 -0.068997 0 0</pose>
        <geometry>
          <box>
            <!-- Size: 1.285130 0.771189 0.226557 becomes 0.12723 0.07226 0.02125 -->
            <size>0.12723 0.07226 0.02125</size>
          </box>
        </geometry>
      </collision>

      <collision name="rear_window">
        <!-- Pose: (0, 1.640531, 1.175126) becomes (0, 0.15378, 0.11017) with rotation -0.262017 -->
        <pose>0 0.15378 0.11017 -0.262017 0 0</pose>
        <geometry>
          <box>
            <!-- Size: 1.267845 1.116344 0.244286 becomes 0.12552 0.10465 0.02290 -->
            <size>0.12552 0.10465 0.02290</size>
          </box>
        </geometry>
      </collision>

      <collision name="trunk">
        <!-- Pose: (0, 1.637059, 0.888180) becomes (0, 0.15367, 0.08341) -->
        <pose>0 0.15367 0.08341 0 0 0</pose>
        <geometry>
          <box>
            <!-- Size: 1.788064 1.138988 0.482746 becomes 0.17602 0.10676 0.04528 -->
            <size>0.17602 0.10676 0.04528</size>
          </box>
        </geometry>
      </collision>

      <collision name="back_bumper">
        <!-- Pose: (0, 2.054454, 0.577870) becomes (0, 0.19253, 0.05414) -->
        <pose>0 0.19253 0.05414 0 0 0</pose>
        <geometry>
          <box>
            <!-- Size: 1.781650 0.512093 0.581427 becomes 0.17638 0.04802 0.05450 -->
            <size>0.17638 0.04802 0.05450</size>
          </box>
        </geometry>
      </collision>
    </link>
    <link name="base_scan">    
      <inertial>
        <pose>-0.052 0 0.131 0 0 0</pose>
        <inertia>
          <ixx>0.001</ixx>
          <ixy>0.000</ixy>
          <ixz>0.000</ixz>
          <iyy>0.001</iyy>
          <iyz>0.000</iyz>
          <izz>0.001</izz>
        </inertia>
        <mass>0.114</mass>
      </inertial>

      <collision name="lidar_sensor_collision">
        <pose>-0.052 0 0.131 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.0508</radius>
            <length>0.055</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="lidar_sensor_visual">
        <pose>-0.064 0 0.151 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>../turtlebot3_waffle/meshes/lds.dae</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh> 
        </geometry>
      </visual>

      <sensor name="hls_lfcd_lds" type="ray">
        <always_on>true</always_on>
        <visualize>true</visualize>
        <pose>-0.064 0 0.151 0 0 0</pose>
        <update_rate>5</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1.000000</resolution>
              <min_angle>0.000000</min_angle>
              <max_angle>6.280000</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.120000</min>
            <max>3.5</max>
            <resolution>0.015000</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
        <plugin name="f1tenth_laserscan" filename="libgazebo_ros_ray_sensor.so">
          <ros>
            <!-- <namespace>/tb3</namespace> -->
            <remapping>~/out:=scan</remapping>
          </ros>
          <output_type>sensor_msgs/LaserScan</output_type>
          <frame_name>base_scan</frame_name>
        </plugin>
      </sensor>
    </link>
    <joint name="lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>base_scan</child>
      <pose>-0.064 0 0.151 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>
    <link name="steering_wheel">
      <!-- Steering wheel pose: (0.627868, 0.357734, 0.988243) becomes (0.06216, 0.03352, 0.09268) -->
      <pose>0.06216 0.03352 0.09268 -1.302101 0 1.57</pose>
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.14583300</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.14583300</iyy>
          <iyz>0</iyz>
          <izz>0.12500000</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <!-- For the cylinder, radius is scaled using an average (≈0.0964) and length by the z-factor -->
            <radius>0.01718</radius>
            <length>0.00392</length>
          </cylinder>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.003</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name="visual">
        <!-- Visual pose inside the link remains zero -->
        <pose>0 0 0 1.302101 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://prius_hybrid/meshes/Hybrid.obj</uri>
            <scale>0.00099 0.000938 0.000938</scale>
            <submesh>
              <name>Steering_Wheel</name>
              <center>true</center>
            </submesh>
          </mesh>
        </geometry>
      </visual>
    </link>

    <link name="front_left_wheel">
      <!-- Pose: (1.41, 0.76, 0.3) becomes (0.13959, 0.07129, 0.02814) -->
      <pose>0.13959 0.07129 0.02814 0 0 1.57</pose>
      <inertial>
        <mass>1.1</mass>
        <inertia>
          <ixx>0.58631238</ixx>
          <ixy>0.0</ixy>
          <iyy>0.33552910</iyy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
          <izz>0.33552910</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <!-- Visual pose: (0.04, 0, 0) becomes (0.00396, 0, 0) -->
        <pose>0.00396 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://prius_hybrid/meshes/Hybrid.obj</uri>
            <scale>0.00099 0.000938 0.000938</scale>
            <submesh>
              <name>Wheel_Front_Left_</name>
              <center>true</center>
            </submesh>
          </mesh>
        </geometry>
      </visual>
      <collision name="collision">
        <!-- Collision pose remains zero with its rotation -->
        <pose>0 0 0 0 1.5708 0</pose>
        <geometry>
          <sphere>
            <!-- Sphere radius: 0.31265 scaled with an average factor (≈0.0964) becomes ~0.03015 -->
            <radius>0.03015</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.9</mu>
              <mu2>0.9</mu2>
              <slip1>0.0</slip1>
              <slip2>0.0</slip2>
            </ode>
          </friction>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <kp>1e9</kp>
            </ode>
          </contact>
        </surface>
      </collision>
    </link>

    <link name="front_right_wheel">
      <!-- Pose: (1.41, -0.76, 0.3) becomes (0.13959, -0.07129, 0.02814) -->
      <pose>0.13959 -0.07129 0.02814 0 0 1.57</pose>
      <inertial>
        <mass>1.1</mass>
        <inertia>
          <ixx>0.58631238</ixx>
          <ixy>0.0</ixy>
          <iyy>0.33552910</iyy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
          <izz>0.33552910</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <!-- Visual pose: (-0.04, 0, 0) becomes (-0.00396, 0, 0) -->
        <pose>-0.00396 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://prius_hybrid/meshes/Hybrid.obj</uri>
            <scale>0.00099 0.000938 0.000938</scale>
            <submesh>
              <name>Wheel_Front_Right</name>
              <center>true</center>
            </submesh>
          </mesh>
        </geometry>
      </visual>
      <collision name="collision">
        <pose>0 0 0 0 1.5708 0</pose>
        <geometry>
          <sphere>
            <radius>0.03015</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.9</mu>
              <mu2>0.9</mu2>
              <slip1>0.0</slip1>
              <slip2>0.0</slip2>
            </ode>
          </friction>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <kp>1e9</kp>
            </ode>
          </contact>
        </surface>
      </collision>
    </link>

    <link name="rear_left_wheel">
      <!-- Pose: (-1.45, 0.786, 0.3) becomes (-0.14355, 0.07367, 0.02814) -->
      <pose>-0.14355 0.07367 0.02814 0 0 1.57</pose>
      <inertial>
        <mass>1.1</mass>
        <inertia>
          <ixx>0.58631238</ixx>
          <ixy>0.0</ixy>
          <iyy>0.33552910</iyy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
          <izz>0.33552910</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <!-- Visual pose: (0.04, 0, 0) becomes (0.00396, 0, 0) -->
        <pose>0.00396 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://prius_hybrid/meshes/Hybrid.obj</uri>
            <scale>0.00099 0.000938 0.000938</scale>
            <submesh>
              <name>Wheel_Front_Left_</name>
              <center>true</center>
            </submesh>
          </mesh>
        </geometry>
      </visual>
      <collision name="collision">
        <pose>0 0 0 0 1.5708 0</pose>
        <geometry>
          <sphere>
            <radius>0.03015</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.1</mu>
              <mu2>1.1</mu2>
              <slip1>0.0</slip1>
              <slip2>0.0</slip2>
            </ode>
          </friction>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <kp>1e9</kp>
            </ode>
          </contact>
        </surface>
      </collision>
    </link>

    <link name="rear_right_wheel">
      <!-- Pose: (-1.45, -0.786, 0.3) becomes (-0.14355, -0.07367, 0.02814) -->
      <pose>-0.14355 -0.07367 0.02814 0 0 1.57</pose>
      <inertial>
        <mass>1.1</mass>
        <inertia>
          <ixx>0.58631238</ixx>
          <ixy>0.0</ixy>
          <iyy>0.33552910</iyy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
          <izz>0.33552910</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <!-- Visual pose: (-0.04, 0, 0) becomes (-0.00396, 0, 0) -->
        <pose>-0.00396 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://prius_hybrid/meshes/Hybrid.obj</uri>
            <scale>0.00099 0.000938 0.000938</scale>
            <submesh>
              <name>Wheel_Front_Right</name>
              <center>true</center>
            </submesh>
          </mesh>
        </geometry>
      </visual>
      <collision name="collision">
        <pose>0 0 0 0 1.5708 0</pose>
        <geometry>
          <sphere>
            <radius>0.03015</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.1</mu>
              <mu2>1.1</mu2>
              <slip1>0.0</slip1>
              <slip2>0.0</slip2>
            </ode>
          </friction>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <kp>1e9</kp>
            </ode>
          </contact>
        </surface>
      </collision>
    </link>

    <link name="rear_axle">
      <!-- Pose: (-1.45, 0, 0.3) becomes (-0.14355, 0, 0.02814) -->
      <pose>-0.14355 0 0.02814 0 0 0</pose>
      <inertial>
        <mass>3.00</mass>
        <inertia>
          <ixx>0.084375</ixx>
          <ixy>0.0</ixy>
          <iyy>4.64581</iyy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
          <izz>4.64581</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <!-- Visual pose remains (0,0,0) but rotated -->
        <pose>0 0 0 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <!-- Cylinder length: 1.357 becomes 0.12728 and radius: 0.075 becomes 0.00723 -->
            <length>0.12728</length>
            <radius>0.00723</radius>
          </cylinder>
        </geometry>
        <material>
          <script>
            <name>Gazebo/Grey</name>
            <uri>file://media/materials/scripts/gazebo.material</uri>
          </script>
        </material>
      </visual>
    </link>

    <!-- Joints: any translation in joint poses is similarly scaled -->
    <joint type="universal" name="front_left_combined_joint">
      <!-- Pose remains 0 since translation is zero except for the rotation offset -->
      <pose>0 0 0 -0.08726646 0 0</pose>
      <child>front_left_wheel</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <!-- +- 50 degrees -->
          <lower>-0.8727</lower>
          <upper>0.8727</upper>
        </limit>
      </axis>
      <axis2>
        <xyz>1 0 0</xyz>
        <dynamics>
          <friction>18.04741</friction>
        </dynamics>
      </axis2>
    </joint>

    <joint type="universal" name="front_right_combined_joint">
      <pose>0 0 0 -0.08726646 0 0</pose>
      <child>front_right_wheel</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.8727</lower>
          <upper>0.8727</upper>
        </limit>
      </axis>
      <axis2>
        <xyz>1 0 0</xyz>
        <dynamics>
          <friction>18.04741</friction>
        </dynamics>
      </axis2>
    </joint>

    <joint type="revolute" name="rear_axle_joint">
      <child>rear_axle</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-0.05089</lower>
          <upper>0.05089</upper>
        </limit>
        <dynamics>
          <spring_stiffness>20000.0</spring_stiffness>
          <damping>2000.0</damping>
        </dynamics>
      </axis>
    </joint>

    <joint type="revolute" name="rear_left_wheel_joint">
      <child>rear_left_wheel</child>
      <parent>rear_axle</parent>
      <axis>
        <xyz>1 0 0</xyz>
        <dynamics>
          <friction>12.03161</friction>
        </dynamics>
      </axis>
    </joint>

    <joint type="revolute" name="rear_right_wheel_joint">
      <child>rear_right_wheel</child>
      <parent>rear_axle</parent>
      <axis>
        <xyz>1 0 0</xyz>
        <dynamics>
          <friction>12.03161</friction>
        </dynamics>
      </axis>
    </joint>

    <joint name="steering_joint" type="revolute">
      <!-- Pose: (-0.002,0,0) becomes (-0.000198, 0, 0) -->
      <pose>-0.000198 0 0 0 0 0</pose>
      <parent>base_link</parent>
      <child>steering_wheel</child>
      <axis>
        <xyz>-0.964118 0.000768 0.265556</xyz>
        <limit>
          <lower>-7.85</lower>
          <upper>7.85</upper>
        </limit>
        <dynamics>
          <damping>1.0</damping>
        </dynamics>
        <use_parent_model_frame>true</use_parent_model_frame>
      </axis>
      <physics>
        <ode>
          <cfm_damping>1</cfm_damping>
        </ode>
      </physics>
    </joint>
    <!-- <joint name="base_joint" type="fixed">
      <parent>base_footprint</parent>
      <child>base_link</child>
      <pose>0.0 0.0 0.010 0 0 0</pose>
    </joint> -->
    <plugin name="ackermann_drive" filename="libgazebo_ros_ackermann_drive.so">
      <ros>
      </ros>
      <update_rate>100.0</update_rate>
      <!-- wheels -->
      <front_left_joint>front_left_combined_joint</front_left_joint>
      <front_right_joint>front_right_combined_joint</front_right_joint>
      <rear_left_joint>rear_left_wheel_joint</rear_left_joint>
      <rear_right_joint>rear_right_wheel_joint</rear_right_joint>
      <left_steering_joint>front_left_combined_joint</left_steering_joint>
      <right_steering_joint>front_right_combined_joint</right_steering_joint>
      <steering_wheel_joint>steering_joint</steering_wheel_joint>
      <!-- Max absolute steer angle for tyre in radians-->
      <max_steer>0.6458</max_steer>
      <!-- Max absolute steering angle of steering wheel -->
      <max_steering_angle>7.85</max_steering_angle>
      <!-- Max absolute linear speed in m/s -->
      <max_speed>20</max_speed>
      <!-- PID tuning -->
      <left_steering_pid_gain>4 0 1</left_steering_pid_gain>
      <left_steering_i_range>0 0</left_steering_i_range>
      <right_steering_pid_gain>4 0 1</right_steering_pid_gain>
      <right_steering_i_range>0 0</right_steering_i_range>
      <linear_velocity_pid_gain>5 0 1</linear_velocity_pid_gain>
      <linear_velocity_i_range>0 0</linear_velocity_i_range>
      <!-- output -->
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>
      <publish_distance>true</publish_distance>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
    </plugin>

    <plugin name="turtlebot3_joint_state" filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <!-- <namespace>/tb3</namespace> -->
        <remapping>~/out:=joint_states</remapping>
      </ros>
      <joint_name>steering_joint</joint_name>
      <joint_name>rear_right_wheel_joint</joint_name>
      <joint_name>rear_left_wheel_joint</joint_name>
      <joint_name>front_left_combined_joint</joint_name>
      <joint_name>front_right_combined_joint</joint_name>
    </plugin>   
  </model>
</sdf>

